# SpectraGuard Configuration
DATABASE_URL=sqlite:///./spectraguard.db
SECRET_KEY=dev-secret-key-not-for-production
JWT_ALGORITHM=HS256
JWT_EXPIRY_MINUTES=480
DEFAULT_ADMIN_PASSWORD=spectraguard-admin
MQTT_BROKER=localhost
MQTT_PORT=1883
MQTT_TOPIC_REJECT=spectraguard/actuator/reject
MQTT_TOPIC_ACK=spectraguard/actuator/ack
BELT_SPEED_MM_S=500.0
REJECT_DELAY_MS=150
SCAN_INTERVAL_MS=200
CALIBRATION_MAX_AGE_HOURS=8
LOG_LEVEL=INFO
DEMO_MODE=true
SIMULATED_ITEMS_PER_MIN=30
CONTAMINATION_RATE=0.08
